<section class="page-heading wrap"><h1>所有文章</h1><p>编程、学习和日常，按时间收在一起。</p></section>
<section class="archive-section wrap" aria-label="文章归档"><div class="archive-grid"><div class="filter-panel"><h2>主题</h2><div class="filter-controls" role="group" aria-label="按主题筛选文章"><% ['全部','编程与建站','学习笔记','日常分享'].forEach((kind,i)=>{ %><button type="button" data-filter="<%= kind %>" aria-pressed="<%= i===0 %>"><%= kind %></button><% }); %></div><a href="<%- url_for('/search/') %>" class="text-link">搜索文章</a></div><div><div class="post-list"><% workbench_posts().forEach(post=>{ %><%- partial('_partial/post-row',{post}) %><% }); %></div><p id="filter-empty" class="empty-state" role="status" hidden>这个主题暂时没有文章。</p></div></div></section>
