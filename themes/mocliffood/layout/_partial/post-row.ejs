<article class="post-row reveal" data-kind="<%= post_kind(post) %>"><div class="post-meta"><span><%= post_kind(post) %></span><time datetime="<%= post.date.toISOString() %>"><%= post.date.format('YYYY.MM.DD') %></time></div><h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3><p><%= post_summary(post) %></p><span class="reading-time">约 <%= read_minutes(post) %> 分钟</span></article>
