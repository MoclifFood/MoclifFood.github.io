<article class="article-shell wrap"><header class="article-heading"><a class="back-link" href="<%- url_for('/archives/') %>">返回文章</a><h1><%= page.title %></h1><div class="post-meta"><time datetime="<%= page.date.toISOString() %>"><%= page.date.format('YYYY 年 M 月 D 日') %></time><span><%= post_kind(page) %></span><span>约 <%= read_minutes(page) %> 分钟</span></div><% if(page.description){ %><p class="article-description"><%= page.description %></p><% } %></header><div class="article-columns"><aside class="article-toc" aria-label="文章目录"><details open><summary>这篇文章</summary><%- toc(page.content,{list_number:false}) %></details></aside><div class="prose"><%- page.content %><div class="article-end"><p>这篇记录到这里。</p><a href="<%- url_for('/archives/') %>">继续阅读其他文章</a></div></div></div></article>
